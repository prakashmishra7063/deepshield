# DeepShield AI backend configuration. Copy to backend/.env and adjust.
# All variables use the DS_ prefix.

DS_ENV=development                      # set to "production" to enforce secret checks
DS_SECRET_KEY=change-me-in-production-please-32+chars   # REQUIRED in production: 32+ random chars (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
DS_DATABASE_URL=sqlite:///./data/deepshield.db           # production: postgresql+psycopg://user:pass@host:5432/deepshield
DS_STORAGE_DIR=./data/storage           # mount an encrypted volume / blob-backed path in production
DS_CORS_ORIGINS=http://localhost:3000   # comma-separated; only needed if the browser calls the API directly
DS_APP_URL=http://localhost:3100        # public web-app URL used in emailed links (verify, reset, invite)
DS_OUTBOX_DIR=./data/outbox             # dev only: emails are saved here when SMTP isn't configured

DS_ACCESS_TOKEN_MINUTES=60
DS_REPORT_LINK_MINUTES=10

# Upload / fetch limits
DS_MAX_UPLOAD_MB=100
DS_MAX_FETCH_MB=50
DS_FETCH_TIMEOUT_S=15
DS_MAX_REDIRECTS=3
DS_ALLOW_PRIVATE_FETCH=false            # tests only; refused when DS_ENV=production

# Data retention for original media (hours)
DS_RETENTION_HOURS=24
DS_WORKER_THREADS=2

# Rate limits
DS_RATE_LIMIT_PER_MINUTE=60
DS_SCAN_RATE_LIMIT_PER_HOUR=120

# Optional deep-learning detectors (TorchScript). Leave unset => reported as "unavailable".
# DS_IMAGE_MODEL_PATH=/models/image_detector.pt
# DS_IMAGE_MODEL_CALIBRATION=/models/image_calibration.json
# DS_AUDIO_MODEL_PATH=/models/audio_detector.pt
# DS_AUDIO_MODEL_CALIBRATION=/models/audio_calibration.json

# Email (verification, password reset, invites, alerts). Required in production.
# Without these, development servers only save emails to DS_OUTBOX_DIR (nothing reaches an inbox).
# Gmail example: host smtp.gmail.com, port 465, your address as user, a Google *App Password* as password.
# DS_SMTP_HOST=smtp.example.com
# DS_SMTP_PORT=587                      # 587 = STARTTLS, 465 = implicit TLS
# DS_SMTP_USER=
# DS_SMTP_PASSWORD=
# DS_SMTP_FROM=DeepShield AI <no-reply@example.com>
# DS_SMTP_STARTTLS=true

# Local development test account (created during development on localhost only; never use in production)
# DEV_TEST_EMAIL=dev-admin@example.com
# DEV_TEST_PASSWORD=Dev-Only-Shield-4821
# DEV_TEST_CUSTOMER_EMAIL=dev-customer@example.com
# DEV_TEST_CUSTOMER_PASSWORD=Dev-Only-Customer-7316
